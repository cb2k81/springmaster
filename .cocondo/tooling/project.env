CPATCH_CONFIG_VERSION=1
CPATCH_PROJECT_ID=springmaster
CPATCH_TOOLKIT_VERSION=1.1.2
CPATCH_RUN_DIRECTORY=.git/cocondo-toolkit/runs
CPATCH_LOCK_DIRECTORY=.git/cocondo-toolkit/locks
CPATCH_ACCEPTED_DIRECTORY=.git/cocondo-toolkit/accepted
CPATCH_STARTING_GRACE_SECONDS=30
CPATCH_RETENTION_DAYS=30
CPATCH_REQUIRE_CLEAN_TREE=true
CPATCH_COMMIT_ON_ACCEPT=true
CPATCH_ALLOWED_BRANCHES_JSON=["main","master","change/*","update/*","sprint/*","release/*","hotfix/*"]
CPATCH_PROFILES_JSON={"docs":["syntax"],"standard":["syntax","targeted"],"full":["syntax","targeted","full"],"release":["syntax","targeted","full","release"]}
CPATCH_AUTO_PROFILE_JSON={"low":"docs","medium":"standard","high":"full","critical":"release"}
CPATCH_VALIDATION_ORDER_JSON=["syntax","targeted","full","release"]
CPATCH_SCOPE_DIR=.cocondo/tooling/scopes
CPATCH_VALIDATOR_DIR=.cocondo/tooling/validators
CPATCH_REQUIRE_WORKTREE=true
CPATCH_REQUIRE_WORKSPACE_FOR_CREATE=true
CPATCH_INTEGRATION_BRANCH=main
CPATCH_MAX_REQUALIFICATION_ATTEMPTS=2
CPATCH_ENVIRONMENT_ALLOWLIST_JSON=["JAVA_HOME","MAVEN_OPTS","NODE_OPTIONS","NPM_CONFIG_CACHE","PLAYWRIGHT_BROWSERS_PATH"]
