      "expectedExit": 1,
      "expectedStatus": "FINDINGS",
      "expectedCode": "REQUIRED_ROOT_FILE_MISSING"
    },
    {
      "id": "wrong-file-type",
      "expectedExit": 1,
      "expectedStatus": "FINDINGS",
      "expectedCode": "FILE_TYPE_NOT_ALLOWED"
    },
    {
      "id": "technical-file-under-docs",
      "expectedExit": 1,
      "expectedStatus": "FINDINGS",
      "expectedCode": "TECHNICAL_FILE_UNDER_DOCUMENTATION"
    },
    {
      "id": "temporary-source-file",
      "expectedExit": 1,
      "expectedStatus": "FINDINGS",
      "expectedCode": "PATH_HYGIENE_VIOLATION"
    },
    {
      "id": "backup-artifact",
      "expectedExit": 1,
      "expectedStatus": "FINDINGS",
      "expectedCode": "PATH_HYGIENE_VIOLATION"
    },
    {
      "id": "case-collision",
      "expectedExit": 1,
      "expectedStatus": "FINDINGS",
      "expectedCode": "CASE_COLLISION"
    },
    {
      "id": "broken-symlink",
      "expectedExit": 1,
      "expectedStatus": "FINDINGS",
      "expectedCode": "SYMLINK_FORBIDDEN",
      "expectedDetail": {
        "broken": true
      }
    },
    {
      "id": "external-symlink",
      "expectedExit": 1,
      "expectedStatus": "FINDINGS",
      "expectedCode": "SYMLINK_FORBIDDEN",
      "expectedDetail": {
        "external": true
      }
    },
    {
      "id": "unapproved-duplicate",
      "mode": "changed",
      "expectedExit": 1,
      "expectedStatus": "FINDINGS",
      "expectedCode": "UNDECLARED_BYTE_DUPLICATE"
