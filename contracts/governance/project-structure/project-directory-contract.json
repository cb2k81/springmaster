      ],
      "newPathPolicy": "allow"
    },
    {
      "id": "test-resources",
      "patterns": [
        "src/test/resources/**"
      ],
      "profiles": [
        "springmaster-source",
        "generated-project",
        "managed-project"
      ],
      "pathClass": "extension-point",
      "sourceKind": "source",
      "commitPolicy": "allowed",
      "allowedSuffixes": [
        ".json",
        ".xml",
        ".yml",
        ".yaml",
        ".md",
