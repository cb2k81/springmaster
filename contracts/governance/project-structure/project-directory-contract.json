      ],
      "newPathPolicy": "allow"
    },
    {
      "id": "platform",
      "patterns": [
        "platform/**"
      ],
      "profiles": [
        "springmaster-source",
        "generated-project",
        "managed-project"
      ],
      "pathClass": "canonical-source",
      "sourceKind": "source",
      "commitPolicy": "allowed",
      "allowedSuffixes": [
        ".env",
        ".json",
        ".md",
        ".py",
        ".sh",
        ".gitkeep",
        ".tpl",
        ".yaml",
        ".yml"
