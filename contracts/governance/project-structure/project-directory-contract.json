  ],
  "technicalDocumentation": {
    "root": "PROJECT_DOCS",
    "humanSuffixes": [
      ".md"
    ],
    "allowedTechnicalAreaIds": [
      "project-docs-config",
      "project-docs-core",
      "project-docs-demo",
      "project-docs-template-source",
      "project-docs-tooling"
    ]
  },
  "duplicatePolicy": {
    "enabledModes": [
      "all",
      "changed"
    ],
    "maxFileSizeBytes": 2097152,
    "excludedPatterns": [
      "patches/logs/**",
      "target/**",
      "build/**",
      "tmp/**",
      "exports/**",
      "patches/runtime/**",
      "patches/archives/**",
      "platform/update/generated/**",
      "platform/update/manifests/**"
    ],
    "allowedPairs": [
      {
        "left": "contracts/database/migration-contract.json",
        "right": "PROJECT_DOCS/TEMPLATES/project-skeleton/files/contracts/database/migration-contract.json.tpl",
        "kind": "qualified-template-derivation"
      },
      {
        "left": "src/main/resources/db/changelog/changes/db.changelog-0000-foundation.xml",
        "right": "PROJECT_DOCS/TEMPLATES/project-skeleton/files/src/main/resources/db/changelog/changes/db.changelog-0000-foundation.xml.tpl",
        "kind": "qualified-template-derivation"
      }
    ]
  },
  "managedProjectDeviationInput": {
    "schemaVersion": "springmaster.managed-project-deviations.v1",
    "expiryField": "expiresAt",
    "pathField": "path",
    "statusField": "status",
    "activeStatuses": [
      "approved",
      "active"
    ]
  }
}
