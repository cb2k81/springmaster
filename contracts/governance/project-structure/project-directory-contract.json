    },
    {
      "id": "platform-generated",
      "patterns": [
        "platform/update/generated/**",
        "platform/update/manifests/**"
      ],
      "profiles": [
        "springmaster-source"
      ],
      "pathClass": "runtime-observed",
      "sourceKind": "generated",
      "commitPolicy": "forbidden",
      "allowedSuffixes": [
