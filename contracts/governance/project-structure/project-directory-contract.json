      "profiles": [
        "springmaster-source"
      ],
      "pathClass": "historical",
      "sourceKind": "source",
      "commitPolicy": "allowed",
      "allowedSuffixes": [
        ".md"
      ],
      "newPathPolicy": "allow"
    },
    {
      "id": "patch-legacy-logs",
      "patterns": [
        "patches/logs/**"
      ],
      "profiles": [
        "springmaster-source"
      ],
      "pathClass": "forbidden-new",
      "sourceKind": "source",
      "commitPolicy": "allowed",
      "allowedSuffixes": [
        ".log",
        ".txt",
        ".md"
      ],
      "newPathPolicy": "baseline-only"
    },
    {
      "id": "generated-project-patches",
      "patterns": [
