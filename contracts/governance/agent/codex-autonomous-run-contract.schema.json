{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:springmaster:schema:codex-autonomous-run:v1",
  "title": "Springmaster Autonomous Logical Run Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "logicalRunId", "taskTemplate", "prompt", "model", "budgets", "patch"],
  "properties": {
    "schemaVersion": {"const": "springmaster.codex-autonomous-run.v1"},
    "logicalRunId": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,50}$"},
    "taskTemplate": {"$ref": "agent-task-contract.schema.json", "description": "Complete immutable springmaster.agent-task.v2 authorization template; taskId is replaced by the deterministic logicalRunId-A<ordinal> identity."},
    "prompt": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["maxAttempts", "activeTimeSeconds", "attemptActiveTimeoutSeconds", "noProgressTimeoutSeconds"],
      "properties": {
        "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 20},
        "activeTimeSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "attemptActiveTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "noProgressTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "patch": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "title", "scope"],
      "properties": {"name": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}}
    }
  }
}
