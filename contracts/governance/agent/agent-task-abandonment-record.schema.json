{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:springmaster:schema:agent-task-abandonment-record:v1",
  "title": "Springmaster Agent Task Abandonment Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "taskId",
    "reason",
    "abandonedAt",
    "baseCommit",
    "integrationHead",
    "worktreePath",
    "worktreeRemoved",
    "codexInvocation",
    "evidenceRetained",
    "newAttemptRequired",
    "abandonmentIntentSha256"
  ],
  "properties": {
    "schemaVersion": {"const": "springmaster.agent-task-abandonment-record.v1"},
    "status": {"const": "ABANDONED_BEFORE_INVOCATION"},
    "taskId": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "reason": {"const": "INTEGRATION_HEAD_ADVANCED"},
    "abandonedAt": {"type": "string", "format": "date-time"},
    "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "integrationHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "worktreePath": {"type": "string", "minLength": 1},
    "worktreeRemoved": {"const": true},
    "codexInvocation": {"const": "NOT_RECORDED"},
    "evidenceRetained": {"const": true},
    "newAttemptRequired": {"const": true},
    "abandonmentIntentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
