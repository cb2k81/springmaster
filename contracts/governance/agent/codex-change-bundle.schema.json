{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cocondo.example/contracts/codex-change-bundle.schema.json",
  "title": "Springmaster Codex Change Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "taskId",
    "repositoryId",
    "baseCommit",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "springmaster.codex-change-bundle.v1"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
    },
    "repositoryId": {
      "const": "springmaster"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "operation", "sourceSha256", "targetSha256", "mode"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "operation": {
            "enum": ["create", "replace", "delete"]
          },
          "sourceSha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "targetSha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "mode": {
            "enum": ["100644", "100755", null]
          }
        }
      }
    }
  }
}
