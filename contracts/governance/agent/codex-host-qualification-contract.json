{
  "contractVersion": "1.6.0",
  "cutoverBoundary": {
    "acceptedImplementationCalibrationCount": 2,
    "automaticPromotionForbidden": true,
    "hostInspectionPassRequired": true,
    "hostQualificationPortable": false,
    "mechanicalProbePassRequired": true,
    "realCodexAnalysisRequired": true,
    "separateHostAuthorizationRequired": true,
    "separateRepositoryPromotionRequired": true
  },
  "durableInvocation": {
    "activeTimeBudget": true,
    "canonicalStartOperation": "codex-host-sandbox invoke-start",
    "defaultActiveTimeoutSeconds": 21600,
    "heartbeatIntervalSeconds": 2,
    "heartbeatWritePolicy": "atomic-replace",
    "maxActiveCreditPerHeartbeatSeconds": 10,
    "noProgressBudget": "optional-active-time",
    "observerLossTerminatesWorker": false,
    "processOwner": "process-ops/crun",
    "singletonKeyPolicy": "stable-task-id-derived",
    "stderrEvidence": "streaming-persistent-file",
    "stdoutEvidence": "streaming-persistent-jsonl",
    "suspendGapPolicy": "credit-at-most-max-active-credit-per-heartbeat",
    "terminalInvocationEvidenceRequiredAfterProcessStart": true
  },
  "hostEvidence": {
    "immutableAfterCompletion": true,
    "machineIdentity": "sha256-of-machine-id-architecture-and-kernel",
    "mustBindBaselineCommit": true,
    "mustBindCodexExecJsonlValidation": true,
    "mustBindCodexSandboxCommandForm": true,
    "mustBindContractSha256": true,
    "mustBindHostCalibrationPlanInput": true,
    "mustBindSandboxArgvSha256": true,
    "requiresNestedCodexSandboxProbes": true,
    "requiresRealCodex": true,
    "schemaVersion": "springmaster.codex-host-qualification-evidence.v1",
    "secretValuesForbidden": true,
    "storage": "external-artifact-root/codex-host-qualification/<host-id>/<baseline-commit>"
  },
  "portableRoles": [
    "PROJECT_ROOT",
    "GIT_COMMON_ROOT",
    "WORKTREE_ROOT",
    "AGENT_RUN_ROOT",
    "ARTIFACT_ROOT",
    "CODEX_HOME"
  ],
  "requiredHostInspection": [
    "linux-kernel",
    "architecture",
    "bubblewrap-present",
    "bubblewrap-basic-namespace",
    "codex-present",
    "codex-version",
    "codex-exec-help",
    "codex-inner-sandbox-smoke",
    "git-version",
    "python-version",
    "project-root",
    "git-common-root",
    "external-roots",
    "roots-outside-operator-home-and-host-temp",
    "outer-sandbox-control-plane-dns",
    "outer-sandbox-control-plane-https"
  ],
  "requiredMechanicalProbes": [
    {
      "expectedOutcome": "PASS",
      "id": "allowed-task-worktree-write"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "write-integration-worktree"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "write-other-worktree"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "write-git-common-directory"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "write-patches-work"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "write-operator-home"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "write-operator-downloads"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "write-external-run-root"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "write-external-artifact-root"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "write-host-temporary-directory"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "path-traversal-escape"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "symlink-escape"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "direct-git-commit"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "direct-patch-accept"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "background-writer"
    },
    {
      "expectedOutcome": "PASS",
      "id": "inner-sandbox-smoke"
    },
    {
      "expectedOutcome": "PASS",
      "id": "inner-worktree-write"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "inner-auth-read"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "inner-network-egress"
    },
    {
      "expectedOutcome": "DENIED",
      "id": "inner-git-common-write"
    }
  ],
  "schemaVersion": "springmaster.codex-host-qualification-contract.v1",
  "securityBoundary": {
    "additionalWritableRoots": [],
    "authoritativeLayer": "outer-linux-bwrap",
    "codexApprovalPolicy": "never",
    "codexExecJsonlValidation": {
      "completedCommandExitCodeRequired": true,
      "completedCommandExitCodeZeroRequiredModes": [
        "analysis",
        "qualification"
      ],
      "completedCommandTerminalStatusRequired": true,
      "errorEventsForbidden": true,
      "implementationCompletedCommandExecutionMinimum": 1,
      "implementationIntermediateCommandFailureAllowed": true,
      "jsonObjectPerNonemptyLineRequired": true,
      "outerProcessExitCodeZeroRequired": true,
      "required": true,
      "startedCommandMustComplete": true,
      "turnCompletedRequired": true,
      "turnFailedForbidden": true
    },
    "codexInnerSandbox": "harness-generated-permission-profile-defense-in-depth",
    "environment": "cleared-and-allowlisted",
    "externalArtifactRoot": "read-only",
    "externalRunRoot": "read-only",
    "gitCommonDirectory": "read-only",
    "hostCalibrationPlanInput": {
      "environmentVariable": "SPRINGMASTER_CODEX_CALIBRATION_PLAN",
      "filesystemSearchForbidden": true,
      "requiredFor": "host-requalification-analysis",
      "sandboxAccess": "read-only",
      "sandboxPath": "/run/codex-input/calibration-plan.json",
      "source": "agent-task-prepare-record.taskAuthorization",
      "sourceMustBeBelowExternalArtifactRoot": true,
      "sourceSha256MustMatchPrepareRecord": true
    },
    "hostPathInheritance": "forbidden",
    "hostTemporaryDirectories": "hidden-by-private-tmp",
    "innerSandboxCommandFormSelection": "capability-probed-fail-closed",
    "integrationWorktree": "read-only",
    "legacySandboxCliPolicy": "forbidden-for-real-invocation",
    "operatorDownloads": "hidden-with-operator-home",
    "operatorHome": "hidden",
    "otherWorktrees": "read-only",
    "patchesWork": "read-only-and-not-a-codex-handoff-channel",
    "sandboxPath": "/usr/local/bin:/usr/bin:/bin",
    "sandboxPrivateAuthToolAccess": "deny-read-and-write",
    "sandboxPrivateCodexHome": "ephemeral-host-directory-with-copied-auth-and-generated-permission-profile-destroyed-after-invocation",
    "sandboxPrivateTmp": "ephemeral-tmpfs",
    "sandboxResolverDependency": "host-resolver-content-copied-into-private-scratch-and-read-only-reexposed-only-when-resolv-conf-target-is-hidden-by-private-run",
    "supportedInnerSandboxCommandForms": [
      "direct",
      "linux-subcommand"
    ],
    "taskWorktree": "mode-dependent-read-only-or-read-write"
  },
  "status": "active",
  "supportedHost": {
    "architectures": [
      "x86_64",
      "aarch64"
    ],
    "operatingSystem": "Linux",
    "sandboxBackend": "bubblewrap",
    "sandboxExecutable": "bwrap"
  }
}
