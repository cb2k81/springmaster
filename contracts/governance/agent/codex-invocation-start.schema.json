{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:springmaster:schema:codex-invocation-start:v1",
  "title": "Springmaster Codex Invocation Start V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "commandId", "recordedAt", "agent", "process", "execution"],
  "properties": {
    "schemaVersion": {"const": "springmaster.codex-invocation-start.v1"},
    "taskId": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "commandId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "recordedAt": {"type": "string", "pattern": "Z$"},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cliVersion", "model", "executablePath", "executableSha256"],
      "properties": {
        "name": {"const": "codex"},
        "cliVersion": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "executablePath": {"type": "string", "pattern": "^/"},
        "executableSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "runId", "singletonKey", "workerPid", "workerPgid", "bootId"],
      "properties": {
        "owner": {"enum": ["foreground-compatibility", "process-ops-crun"]},
        "runId": {"type": ["string", "null"]},
        "singletonKey": {"type": ["string", "null"]},
        "workerPid": {"type": "integer", "minimum": 1},
        "workerPgid": {"type": "integer", "minimum": 1},
        "bootId": {"type": "string", "minLength": 1}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "workingDirectory", "sandboxProfile", "approvalPolicy", "platformSandbox", "environmentKeys", "startedAt", "stdoutPath", "stderrPath", "heartbeatPath", "activeTimeoutSeconds", "noProgressTimeoutSeconds"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "workingDirectory": {"type": "string", "pattern": "^/"},
        "sandboxProfile": {"enum": ["linux-bwrap-read-only", "linux-bwrap-workspace-write"]},
        "approvalPolicy": {"const": "never"},
        "platformSandbox": {"type": "object"},
        "environmentKeys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "startedAt": {"type": "string", "pattern": "Z$"},
        "stdoutPath": {"type": "string", "pattern": "^/"},
        "stderrPath": {"type": "string", "pattern": "^/"},
        "heartbeatPath": {"type": "string", "pattern": "^/"},
        "activeTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "noProgressTimeoutSeconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 86400}
      }
    }
  }
}
