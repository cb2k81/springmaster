{
  "schemaVersion": "cocondo.process-operations-contract.v1",
  "projectNeutral": true,
  "pathResolution": {
    "projectRoot": "git-rev-parse-show-toplevel",
    "gitCommonDirectory": "git-rev-parse-absolute-git-common-dir",
    "integrationWorktree": "git-worktree-list-by-configured-integration-branch",
    "artifactRootSources": [
      "COCONDO_ARTIFACT_ROOT",
      "git-config:cocondo.artifactRoot"
    ],
    "worktreeRootSources": [
      "COCONDO_WORKTREE_ROOT",
      "git-config:cocondo.worktreeRoot"
    ],
    "absolutePortablePathsForbidden": true
  },
  "runtimeDirectories": {
    "toolkitRuns": "CPATCH_RUN_DIRECTORY",
    "toolkitLocks": "CPATCH_LOCK_DIRECTORY",
    "toolkitAccepted": "CPATCH_ACCEPTED_DIRECTORY",
    "processState": "CPROCESS_STATE_DIRECTORY",
    "processIncidents": "CPROCESS_INCIDENT_DIRECTORY",
    "gitRelativePathsUseCommonDirectory": true,
    "trackedWorkingTreeMutationForbidden": true,
    "operatorLogs": "CPROCESS_OPERATOR_LOG_DIRECTORY",
    "operatorWorkspace": "CPROCESS_WORK_DIRECTORY",
    "processDeliveries": "CPROCESS_DELIVERY_DIRECTORY",
    "artifactRootAuthorization": "CPROCESS_ARTIFACT_AUTHORIZATION_RECORD"
  },
  "workingTreePolicy": {
    "mutatingPatchRunsRequireCleanIntegrationWorktree": true,
    "featureWorktreeMayInvokeIntegrationRun": true,
    "observerCommandsDoNotRequireCleanFeatureWorktree": true,
    "blindRetryForbidden": true,
    "duplicatePreparationMutationForbidden": true
  },
  "backgroundPolicy": {
    "workerOwner": "cocondo-toolkit-run-api",
    "nestedDetachmentForbidden": true,
    "externalSupervisorForbidden": true,
    "genericCommandsUse": "crun",
    "patchRunsUse": "cpatch",
    "observerLossDoesNotStopWorker": true,
    "singletonStartSupported": true,
    "singletonLockDirectory": "CPROCESS_STATE_DIRECTORY/locks",
    "singletonPointerDirectory": "CPROCESS_STATE_DIRECTORY/pointers",
    "duplicateActiveStart": "REUSE_EXISTING_RUN",
    "terminalRestartRequiresExplicitFlag": true
  },
  "observerPolicy": {
    "commands": [
      "status",
      "resume",
      "watch",
      "wait",
      "result"
    ],
    "defaultTerminalSafeExit": true,
    "strictExitMustBeExplicit": true,
    "compactOutputByDefault": true,
    "verboseResultMustBeExplicit": true
  },
  "rolloutPolicy": {
    "managedProjectRollout": "BLOCKED_PENDING_SPRINGMASTER_PILOT",
    "requiredPilotScenarios": [
      "linked-worktree-resolution",
      "terminal-loss",
      "watcher-interrupt",
      "run-id-resume",
      "orphan-reconciliation",
      "transient-status-failure",
      "no-nested-detachment",
      "portable-sidecars",
      "bounded-terminal-output",
      "clean-integration-guard",
      "duplicate-start-reuse",
      "atomic-singleton-pointer",
      "multiple-active-singleton-detection",
      "registered-tooling-tests",
      "registered-source-fixtures",
      "stage-specific-failure-evidence",
      "operator-workspace-clean-start",
      "active-workspace-cleanup-blocked",
      "workspace-symlink-blocked",
      "workspace-tracked-content-blocked",
      "diagnostic-handoff-single-archive",
      "operator-log-project-local",
      "workspace-export-excluded",
      "agent-workspace-write-forbidden",
      "operator-log-historical-tracked-sibling-compatible",
      "operator-log-current-run-tracked-content-blocked",
      "workspace-before-every-writer",
      "workspace-missing-root-blocked",
      "workspace-mount-blocked",
      "workspace-special-file-blocked",
      "workspace-nested-repository-blocked",
      "workspace-unresolved-run-blocked",
      "artifact-root-explicit-authorization",
      "artifact-root-config-only-blocked",
      "artifact-root-canonical-binding",
      "artifact-root-forbidden-locations",
      "artifact-root-no-implicit-create",
      "typed-delivery-inventory",
      "known-historical-metadata-classified",
      "generic-run-id-ignored",
      "patch-run-id-reserved",
      "legacy-numeric-patch-run-evidence-reserved",
      "current-delivery-exact-once",
      "unknown-delivery-entry-blocked",
      "delivery-identity-conflict-blocked",
      "selfcheck-substep-start-result-evidence",
      "selfcheck-failed-substep-visible"
    ]
  },
  "implementation": {
    "entrypoint": "bin/process-ops.sh",
    "python": "bin/process-ops.py",
    "integrationTest": "bin/process-ops-it.sh",
    "guide": "PROJECT_DOCS/TOOLING/PROCESS_OPERATIONS.md",
    "knownErrors": "PROJECT_DOCS/TOOLING/PROCESS_KNOWN_ERRORS.md",
    "decision": "PROJECT_DOCS/ADR/ADR-0014-process-execution-observation-and-recovery.md",
    "config": ".cocondo/process.env"
  },
  "qualificationPolicy": {
    "orderedStages": [
      "syntax-and-contracts",
      "test-inventory-and-fixture-registration",
      "focused-integration-tests",
      "tooling-selfcheck-no-export",
      "detached-patch-dry-run",
      "explicit-accept"
    ],
    "stageLogsRequired": true,
    "failedStageRequired": true,
    "genericFailureWithoutStageIsInsufficient": true,
    "gitFixtureIsolation": {
      "systemConfig": "disabled",
      "globalConfig": "disabled",
      "homeAndXdgConfig": "isolated-temporary-directories",
      "templateDirectory": "isolated-empty-directory",
      "terminalPrompt": "disabled",
      "fixtureReferenceBackend": "files-via-git-config",
      "directGitRefFilesystemInspectionForbidden": true,
      "failedFixtureStepRequired": true
    }
  },
  "contractVersion": "1.2.0",
  "operatorWorkspacePolicy": {
    "scope": "one-current-writer-workflow",
    "pathMustBeProjectRelative": true,
    "defaultDirectory": "patches/work",
    "rootMustAlreadyExist": true,
    "implicitRootCreation": "forbidden",
    "cleanupTrigger": "before-each-writer",
    "writers": [
      "workspace-start",
      "patch-dry-run",
      "patch-accept",
      "diagnose",
      "incident",
      "diagnostic-handoff",
      "delivery-prepare"
    ],
    "observerMutationForbidden": true,
    "activeWorkflowCleanup": "block",
    "unresolvedWorkflowCleanup": "block",
    "trackedContent": "block",
    "symlinkContent": "block",
    "nestedRepositoryContent": "block",
    "specialFileContent": "block",
    "mountPointContent": "block",
    "safeUntrackedTerminalWorkflowContent": "remove",
    "workspaceRootPreserved": true,
    "cleanupEvidenceFields": [
      "operationId",
      "operation",
      "subject",
      "removedEntryCount",
      "removedEntryListSha256",
      "preparedAt"
    ],
    "workspaceRecord": "WORKSPACE.json",
    "workspaceRecordSchema": "cocondo.operator-workspace.v2",
    "diagnosticHandoffCommand": "diagnostic-handoff",
    "diagnosticArchiveCount": 1,
    "agentWritePolicy": "forbidden"
  },
  "operatorLogPolicy": {
    "pathMustBeProjectRelative": true,
    "defaultDirectory": "patches/logs/validation",
    "runScoped": true,
    "canonicalRunStateRemainsInGitCommonDirectory": true,
    "commitPolicy": "forbidden",
    "exportPolicy": "excluded",
    "symlinkPath": "block",
    "pathPreparation": "fail-closed-current-run-directory",
    "historicalTrackedSiblings": "allow",
    "currentRunDirectoryTrackedContent": "block",
    "currentRunDirectoryIgnored": "required",
    "runDirectoryPattern": "<operator-log-root>/<patch-id>/<run-id>"
  },
  "writerPolicy": {
    "commands": [
      "workspace-start",
      "patch-dry-run",
      "patch-accept",
      "diagnose",
      "incident",
      "diagnostic-handoff",
      "delivery-prepare"
    ],
    "centralFacade": "bin/process-ops.sh",
    "workspaceStartRequired": true,
    "freeChatOrchestration": "forbidden",
    "workerStartBeforePreflight": "forbidden"
  },
  "artifactRootAuthorizationPolicy": {
    "configurationIsAuthorization": false,
    "configurationSources": [
      "COCONDO_ARTIFACT_ROOT",
      "git-config:cocondo.artifactRoot"
    ],
    "configurationAmbiguity": "BLOCKING_TOOL_ERROR",
    "rootMustAlreadyExist": true,
    "implicitRootCreation": "forbidden",
    "canonicalPathRequired": true,
    "authorizationRecord": "CPROCESS_ARTIFACT_AUTHORIZATION_RECORD",
    "recordSchema": "cocondo.artifact-root-authorization.v1",
    "recordBinding": [
      "projectId",
      "configuredPath",
      "canonicalPath",
      "device",
      "inode"
    ],
    "forbiddenLocations": [
      "repository",
      "git-common-directory",
      "operator-home",
      "downloads",
      "system-temporary-directories"
    ],
    "unauthorizedWorkerStart": "block",
    "remediationStateRoot": "CPROCESS_DELIVERY_DIRECTORY"
  },
  "deliveryInventoryPolicy": {
    "deliveryRoot": "CPROCESS_DELIVERY_DIRECTORY",
    "runRoot": "CPATCH_RUN_DIRECTORY",
    "entryPolicies": {
      "deliveryDirectory": "RESERVE",
      "knownHistoricalMetadata": "IGNORE_AND_COUNT",
      "genericRunRecord": "IGNORE_AND_COUNT",
      "patchRunRecord": "RESERVE",
      "legacyNumericPatchRunRecord": "RESERVE",
      "currentDelivery": "CURRENT_DELIVERY_EXCEPTION",
      "unknownRegularFile": "BLOCKING_TOOL_ERROR",
      "symlink": "BLOCKING_TOOL_ERROR",
      "specialFile": "BLOCKING_TOOL_ERROR",
      "unreadableOrInconsistentJson": "BLOCKING_TOOL_ERROR",
      "identityConflict": "BLOCKING_TOOL_ERROR",
      "acceptedPatchRecord": "RESERVE",
      "historicalFailedRunUnderAcceptedOwner": "IGNORE_AND_COUNT"
    },
    "knownMetadataPatterns": [
      "*-accept-discovery.env",
      "*-accept-run-*-result.env",
      "*-accept-run-*-start.json",
      "*-dry-run-result.json",
      "*-dry-run-run-*-start.json",
      "*-post-accept-result.json",
      "*-artifact-zip-test.log",
      "*-process-operations-revision*.env",
      "*-process-operations-revision*.json",
      "*-process-ops-resolve.env",
      "*-revision-prepare.run-id",
      "*-final.env",
      "*-process-ops-git-fixture-hermeticity.env",
      "*-workspace-check.json",
      "*-workspace-init.json"
    ],
    "patchScopeFields": [
      "artifactId",
      "operation",
      "workflow"
    ],
    "patchIdPattern": "^[0-9]{6}_[A-Za-z0-9][A-Za-z0-9._-]*$",
    "deliveryIdPattern": "^[0-9]{6}-[A-Za-z0-9][A-Za-z0-9._-]*$",
    "freeTextNumbersReserveIdentity": false,
    "currentDeliveryMatchCount": 1,
    "nextIdSource": "typed-reserved-identities-only",
    "legacyNumericPatchRunCompatibility": {
      "policy": "RESERVE",
      "recordSchema": "cocondo.run-record.v1",
      "commands": [
        "patch-dry-run",
        "patch-accept"
      ],
      "numericPatchIdPattern": "^[0-9]{6}$",
      "canonicalPatchIdSource": "metadata.artifactFile",
      "artifactFilePattern": "^[A-Za-z0-9._-]+__(?P<patchId>[0-9]{6}_[A-Za-z0-9][A-Za-z0-9._-]*)__+(?P<artifactToken>[0-9a-fA-F]{8})\\.zip$",
      "artifactIdPattern": "^urn:uuid:(?P<artifactToken>[0-9a-fA-F]{8})-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "requirePatchNumberMatch": true,
      "requireArtifactTokenMatch": true,
      "unverifiedOrConflicting": "BLOCKING_TOOL_ERROR"
    },
    "acceptedPatchAuthority": {
      "policy": "RESERVE",
      "recordSchema": "cocondo.patch-acceptance.v2",
      "artifactIdPattern": "^urn:uuid:(?P<artifactUuid>[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "numericPatchIdPattern": "^[0-9]{6}$",
      "numericResolutionCommand": "patch-accept",
      "numericResolutionStatus": "SUCCEEDED",
      "historicalFailedStatuses": [
        "ABORTED",
        "FAILED",
        "INCONSISTENT",
        "ORPHANED"
      ],
      "differentDeliveryOrNonFailedRun": "BLOCKING_TOOL_ERROR",
      "multipleAcceptedOwners": "BLOCKING_TOOL_ERROR"
    }
  }
}
