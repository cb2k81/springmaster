{
  "schemaVersion": "springmaster.engineering-evidence-contract.v1",
  "contractVersion": "1.0.0",
  "status": "report-only",
  "ruleSource": "PROJECT_DOCS/GOVERNANCE/ENGINEERING_GOVERNANCE.md",
  "evidenceSchema": "springmaster.engineering-evidence.v1",
  "evidenceIdPattern": "^ENG-EVID-[A-Z0-9-]{3,80}$",
