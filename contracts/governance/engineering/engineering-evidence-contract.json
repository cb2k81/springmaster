    "evidenceId",
    "changeRef",
    "sprintRef",
    "baseline",
    "acceptedScope",
    "classification",
    "profileSelection",
    "ruleSources",
    "executions",
    "findings",
    "deferrals",
    "technicalDebt",
    "impact",
    "artifactFamilies",
    "technicalStatus",
    "completionRef"
  ],
  "baselineRequiredFields": [
    "gitHead",
    "dirty",
    "sourceExportSha256"
