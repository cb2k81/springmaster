{
  "schemaVersion": "springmaster.maintenance-recovery-contract.v1",
  "contractVersion": "1.0.1",
  "status": "report-only",
  "ruleSource": "PROJECT_DOCS/ADR/ADR-0020-enabling-governance-and-recoverable-tooling.md",
  "recordSchema": "springmaster.maintenance-recovery.v1",
  "recordIdPattern": "^MAINT-REC-[A-Z0-9-]{3,80}$",
  "reusedContracts": {
    "changeClassesAndRiskLevels": "springmaster.change-classification-contract.v1",
    "qualificationProfiles": "springmaster.engineering-profile-contract.v1",
    "executionAndFindingStates": "springmaster.engineering-evidence-contract.v1",
    "completionTruth": "springmaster.engineering-completion-contract.v1"
  },
  "requiredFields": [
    "schemaVersion",
    "recordId",
    "authority",
    "classification",
    "defect",
    "baseline",
    "isolatedWorktree",
    "authorizedRepairPaths",
    "actualRepairPaths",
    "authorizedCapabilities",
    "usedCapabilities",
    "forbiddenOperations",
    "observedForbiddenOperations",
    "unaffectedBootstrapCommands",
    "targetedQualification",
    "finalQualification",
    "disposition",
    "recoverability"
  ],
  "defectRequiredFields": ["component", "entrypoint", "reasonCode", "category", "message"],
  "failureCategories": ["PRODUCT", "TOOLING", "ENVIRONMENT", "GOVERNANCE"],
  "baselineRequiredFields": ["gitHead", "integrationRef", "integrationTreeSha256"],
  "worktreeRequiredFields": ["path", "baseCommit", "detached", "integrationWorktree"],
  "repairPathPattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\*?\\[]).+$",
  "allowedCapabilities": [
    "read-source",
    "edit-authorized-paths",
    "run-unaffected-bootstrap",
    "run-targeted-qualification",
    "run-final-qualification",
    "prepare-integration-disposition",
    "prepare-delivery-disposition"
  ],
  "mandatoryForbiddenOperations": [
    "direct-main-mutation",
    "push",
    "cross-project-mutation"
  ],
  "qualificationRequiredFields": ["profileId", "command", "status", "exitCode", "reportRefs"],
  "targetedProfiles": ["fast", "qualification"],
  "finalProfile": "qualification",
  "integrationDispositions": ["not-requested", "candidate-ready", "requires-human-integration"],
  "deliveryDispositions": ["not-requested", "requires-cpatch", "requires-human-accept"],
  "recoverabilityRequiredFields": ["recoverable", "maintenanceAllowed", "safeNextAction"],
  "passStatus": "passed",
  "successExitCode": 0,
  "worktreeIsolationPolicy": {
    "allowAttachedIsolatedBranch": true,
    "allowDetachedWorktree": true,
    "integrationWorktreeForbidden": true
  },
  "qualificationEvidenceStatuses": ["passed", "passed-with-findings", "blocked", "tool-error"],
  "blockedDisposition": {
    "integration": "not-requested",
    "delivery": "not-requested"
  },
  "successfulRecoveryRequires": {
    "recoverable": true,
    "maintenanceAllowed": true
  }
}
