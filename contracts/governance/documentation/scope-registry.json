{
  "schemaVersion": "springmaster.documentation-scope-registry.v1",
  "scopeLevels": [
    "ecosystem",
    "platform",
    "project",
    "subsystem",
    "component",
    "layer",
    "capability",
    "interface",
    "data",
    "operation"
  ],
  "appliesToValues": [
    "springmaster",
    "project-new",
    "generated-projects",
    "managed-projects"
  ],
  "scopes": [
    {
      "id": "springmaster/documentation",
      "level": "ecosystem",
      "kind": "logical",
      "description": "Documentation governance, lifecycle and discoverability for Springmaster and propagated projects",
      "physicalPaths": [
        "PROJECT_DOCS/**",
        "contracts/governance/documentation/**"
      ]
    },
    {
      "id": "springmaster/documentation/templates",
      "level": "ecosystem",
      "kind": "logical",
      "parent": "springmaster/documentation",
      "description": "Human-maintained documentation templates",
      "physicalPaths": [
        "PROJECT_DOCS/_TEMPLATES/**"
      ]
    },
    {
      "id": "springmaster/tooling/documentation-gate",
      "level": "component",
      "kind": "logical",
      "parent": "springmaster/documentation",
      "description": "Documentation gate implementation and fixtures",
      "physicalPaths": [
        "bin/documentation-gate*",
        "src/test/resources/tooling/documentation-gate-v2/**"
      ]
    },
    {
      "id": "springmaster/governance",
      "level": "ecosystem",
      "kind": "logical",
      "description": "Cross-cutting Springmaster governance documents",
      "physicalPaths": [
        "PROJECT_DOCS/GOVERNANCE/**"
      ]
    },
    {
      "id": "springmaster/standards",
      "level": "platform",
      "kind": "logical",
      "description": "Reusable technical standards",
      "physicalPaths": [
        "PROJECT_DOCS/STANDARDS/**"
      ]
    },
    {
      "id": "springmaster/project-structure",
      "level": "ecosystem",
      "kind": "logical",
      "description": "Repository structure, canonical ownership, extension points and directory migration governance",
      "physicalPaths": [
        "PROJECT_DOCS/GOVERNANCE/PROJECT_DIRECTORY_GOVERNANCE.md",
        "contracts/governance/project-structure/**"
      ]
    },
    {
      "id": "springmaster/engineering",
      "level": "ecosystem",
      "kind": "logical",
      "description": "Technical change lifecycle, classification, readiness, profile selection and completion governance",
      "physicalPaths": [
        "PROJECT_DOCS/GOVERNANCE/ENGINEERING_GOVERNANCE.md",
        "contracts/governance/engineering/**"
      ]
    },
    {
      "id": "springmaster/quality-gates",
      "level": "ecosystem",
      "kind": "logical",
      "description": "Quality rule, gate, enforcement, baseline, waiver and suppression governance",
      "physicalPaths": [
        "PROJECT_DOCS/GOVERNANCE/QUALITY_GATE_GOVERNANCE.md",
        "contracts/governance/quality/**"
      ]
    },
    {
      "id": "springmaster/testing",
      "level": "ecosystem",
      "kind": "logical",
      "description": "Test strategy, test levels, evidence, coverage governance and test completion",
      "physicalPaths": [
        "PROJECT_DOCS/GOVERNANCE/TEST_GOVERNANCE.md",
        "contracts/governance/testing/**"
      ]
    },
    {
      "id": "springmaster/dependencies",
      "level": "ecosystem",
      "kind": "logical",
      "description": "External dependency request, approval, version, security and removal governance",
      "physicalPaths": [
        "PROJECT_DOCS/GOVERNANCE/DEPENDENCY_GOVERNANCE.md",
        "contracts/governance/dependencies/**"
      ]
    },
    {
      "id": "springmaster/standards/java-architecture",
      "level": "capability",
      "kind": "logical",
      "parent": "springmaster/standards",
      "description": "Java namespace, package, dependency-direction, Spring boundary and architecture-test standard",
      "physicalPaths": [
        "PROJECT_DOCS/STANDARDS/ARCHITECTURE/JAVA_ARCHITECTURE_STANDARD.md"
      ]
    },
    {
      "id": "springmaster/standards/java-coding",
      "level": "capability",
      "kind": "logical",
      "parent": "springmaster/standards",
      "description": "Java source structure, visibility, documentation and clean-code standard",
      "physicalPaths": [
        "PROJECT_DOCS/STANDARDS/JAVA/JAVA_CODING_STANDARD.md"
      ]
    },
    {
      "id": "springmaster/standards/testing",
      "level": "capability",
      "kind": "logical",
      "parent": "springmaster/standards",
      "description": "Automated test-code, fixture, assertion and test-double implementation standard",
      "physicalPaths": [
        "PROJECT_DOCS/STANDARDS/TESTING/TESTING_STANDARD.md"
      ]
    }
  ]
}
